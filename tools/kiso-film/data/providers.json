{
  "schemaVersion": 1,
  "providers": [
    {
      "id": "fal",
      "label": "fal.ai",
      "keyEnv": "FAL_KEY",
      "verified": false,
      "auth": { "header": "authorization", "format": "Key {key}" },
      "submit": {
        "urlTemplate": "https://queue.fal.run/{providerModelId}",
        "jobIdPaths": ["request_id"]
      },
      "poll": {
        "urlTemplate": "https://queue.fal.run/{providerModelId}/requests/{jobId}/status",
        "statusPaths": ["status"],
        "doneStates": ["COMPLETED", "OK"],
        "failedStates": ["FAILED", "ERROR", "CANCELLED"],
        "workingStates": ["IN_QUEUE", "IN_PROGRESS"],
        "errorPaths": ["error", "detail"],
        "intervalMs": 3000
      },
      "result": {
        "urlTemplate": "https://queue.fal.run/{providerModelId}/requests/{jobId}",
        "outputUrlPaths": ["video.url", "images.0.url", "image.url", "output.url"]
      }
    },
    {
      "id": "byteplus",
      "label": "BytePlus ModelArk",
      "keyEnv": "BYTEPLUS_API_KEY",
      "verified": false,
      "auth": { "header": "authorization", "format": "Bearer {key}" },
      "submit": {
        "urlTemplate": "https://ark.ap-southeast.bytepluses.com/api/v3/contents/generations/tasks",
        "jobIdPaths": ["id", "data.id"]
      },
      "poll": {
        "urlTemplate": "https://ark.ap-southeast.bytepluses.com/api/v3/contents/generations/tasks/{jobId}",
        "statusPaths": ["status", "data.status"],
        "doneStates": ["succeeded", "SUCCEEDED"],
        "failedStates": ["failed", "FAILED", "cancelled", "CANCELLED"],
        "workingStates": ["queued", "running", "QUEUED", "RUNNING"],
        "errorPaths": ["error.message", "message"],
        "intervalMs": 3000
      },
      "result": {
        "urlTemplate": "https://ark.ap-southeast.bytepluses.com/api/v3/contents/generations/tasks/{jobId}",
        "outputUrlPaths": ["content.video_url", "data.content.video_url", "content.image_url"]
      }
    }
  ]
}
